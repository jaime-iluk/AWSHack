# Copiar a .env.local (no se sube a git). Con DEMO_OFFLINE=1 todo corre con respuestas fijas.
DEMO_OFFLINE=0
NEXT_PUBLIC_DEMO_OFFLINE=0

# --- B1: agente real (Amazon Bedrock) ---
AWS_REGION=us-east-1
# Una de estas formas de credencial:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=
# AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-5-5
AGENT_TIMEOUT_MS=8000

# --- B2: aviso real por WhatsApp (sandbox de Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número del sandbox que muestra la consola de Twilio
TWILIO_FROM=whatsapp:+14155238886
# Celular del equipo que ya mandó "join <palabra>" al sandbox
NOTIFY_TO=whatsapp:+52XXXXXXXXXX
