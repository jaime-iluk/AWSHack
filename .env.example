# Copiar a .env.local y llenar. Sin estas variables la demo funciona igual con respuestas fijas.

# 1 = no llama a Bedrock ni a Twilio (demo 100 % offline)
DEMO_OFFLINE=0

# Agente (Amazon Bedrock)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Verificar en la consola de Bedrock el ID del modelo habilitado en su cuenta/región
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Aviso real por WhatsApp (sandbox de Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
DEMO_PHONE_TO=whatsapp:+521XXXXXXXXXX
